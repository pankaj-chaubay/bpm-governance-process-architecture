      <bpmndi:BPMNShape id="g_major_di" bpmnElement="g_major" isMarkerVisible="true">
        <dc:Bounds x="1475" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rca_di" bpmnElement="rca">
        <dc:Bounds x="1605" y="395" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_merge2_di" bpmnElement="g_merge2" isMarkerVisible="true">
        <dc:Bounds x="1795" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="close_di" bpmnElement="close">
        <dc:Bounds x="1925" y="115" width="110" height="70" />
