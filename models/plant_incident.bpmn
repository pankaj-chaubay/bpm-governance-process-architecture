      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="90" y="360" width="2210" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="202" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="log_di" bpmnElement="log">
        <dc:Bounds x="325" y="115" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="diag_di" bpmnElement="diag">
        <dc:Bounds x="485" y="115" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_remote_di" bpmnElement="g_remote" isMarkerVisible="true">
        <dc:Bounds x="675" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="disp_di" bpmnElement="disp">
        <dc:Bounds x="805" y="115" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="repair_di" bpmnElement="repair">
        <dc:Bounds x="965" y="255" width="110" height="70" />
