      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_di" bpmnElement="fix">
        <dc:Bounds x="805" y="115" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="board_di" bpmnElement="board">
        <dc:Bounds x="805" y="255" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_dec_di" bpmnElement="g_dec" isMarkerVisible="true">
        <dc:Bounds x="995" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sign_di" bpmnElement="sign">
        <dc:Bounds x="1125" y="395" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok">
        <dc:Bounds x="1322" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_hold_di" bpmnElement="end_hold">
        <dc:Bounds x="1162" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="238" y="150" />
        <di:waypoint x="325" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
