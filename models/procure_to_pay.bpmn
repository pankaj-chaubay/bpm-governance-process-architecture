<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_P05_1_1" targetNamespace="https://example.org/aurora/processes">
  <bpmn:collaboration id="Collab_Process_P05_1_1">
    <bpmn:participant id="Pool_Process_P05_1_1" name="Procure goods and services" processRef="Process_P05_1_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P05_1_1" name="Procure goods and services" isExecutable="false">
    <bpmn:documentation>Owner: Head of Procurement; Version: 3.0; Catalog ID: P05.1.1</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_P05_1_1">
      <bpmn:lane id="Lane_0" name="Requester">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Procurement">
        <bpmn:flowNodeRef>appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Supplier">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Accounts payable">
        <bpmn:flowNodeRef>inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Need identified">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="pr" name="Create purchase requisition">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_val" name="Above approval limit?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="appr" name="Approve purchase requisition">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_merge">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="po" name="Create purchase order">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send" name="Send purchase order">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="deliver" name="Deliver goods or service">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="gr" name="Confirm goods receipt">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="inv" name="Receive invoice">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="match" name="Match invoice to order and receipt">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_match" name="Three-way match OK?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="clar" name="Resolve invoice difference">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pay" name="Pay invoice">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Invoice paid">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="pr" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="pr" targetRef="g_val" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g_val" targetRef="appr" name="Yes" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g_val" targetRef="g_merge" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="appr" targetRef="g_merge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="g_merge" targetRef="po" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="po" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="send" targetRef="deliver" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="deliver" targetRef="gr" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="gr" targetRef="inv" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="inv" targetRef="match" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="match" targetRef="g_match" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="g_match" targetRef="pay" name="Yes" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="g_match" targetRef="clar" name="No" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="clar" targetRef="match" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="pay" targetRef="end" />
  </bpmn:process>
