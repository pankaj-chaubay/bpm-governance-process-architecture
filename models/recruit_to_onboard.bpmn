<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_P04_1_1" targetNamespace="https://example.org/aurora/processes">
  <bpmn:collaboration id="Collab_Process_P04_1_1">
    <bpmn:participant id="Pool_Process_P04_1_1" name="Recruit and onboard employee" processRef="Process_P04_1_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P04_1_1" name="Recruit and onboard employee" isExecutable="false">
    <bpmn:documentation>Owner: Head of Talent Acquisition; Version: 1.2; Catalog ID: P04.1.1</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_P04_1_1">
      <bpmn:lane id="Lane_0" name="Hiring manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>int</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_off</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>day1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Recruiter">
        <bpmn:flowNodeRef>pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="HR operations">
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="IT service desk">
        <bpmn:flowNodeRef>it</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Vacancy approved">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="req" name="Create job requisition">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="pub" name="Publish job advert">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="scr" name="Screen applications">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_sl" name="Suitable candidates?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="int" name="Interview candidates">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_off" name="Candidate selected?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="offer" name="Send offer">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_acc" name="Offer accepted?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="split">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="contract" name="Issue employment contract">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="record" name="Create employee record">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="it" name="Provision laptop and accounts">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="join">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="day1" name="Run first-day onboarding">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_ok" name="Employee onboarded">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_no" name="Vacancy closed unfilled">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="req" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="req" targetRef="pub" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="pub" targetRef="scr" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="scr" targetRef="g_sl" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g_sl" targetRef="int" name="Yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="g_sl" targetRef="pub" name="No" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="int" targetRef="g_off" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="g_off" targetRef="offer" name="Yes" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="g_off" targetRef="end_no" name="No" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="offer" targetRef="g_acc" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="g_acc" targetRef="split" name="Yes" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="g_acc" targetRef="end_no" name="No" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="split" targetRef="contract" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="split" targetRef="record" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="split" targetRef="it" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="contract" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="record" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="it" targetRef="join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="join" targetRef="day1" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="day1" targetRef="end_ok" />
  </bpmn:process>
